{
  "name": "servicehub",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "npm run build:client && node server.js",
    "dev": "nodemon server.js",
    "dev:server": "nodemon server.js",
    "dev:client": "npm run dev --prefix frontend",
    "dev:all": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"wait-on http://127.0.0.1:8080 -t 30000 && npm run dev:client\"",
    "install:all": "npm install && npm install --prefix frontend",
    "build:client": "npm run build --prefix frontend",
    "seed": "node Backend/scripts/seed.js"
  },
  "author": "",
  "license": "ISC",
  "keywords": [],
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.24.4",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "wait-on": "^8.0.5"
  }
}
